#!/usr/bin/env swift
//MISE description="The window through macOS accessibility: `ax tree [window] | ax press <label> | ax size <w> <h> | ax windows`"
// The accessibility tree is what a screen reader sees, and what an agent reads instead of a
// screenshot: every element GPUI gave a role and a label. `press` performs the element's own
// action through the same channel, so nothing moves the pointer or takes the keyboard. See
// spec/workflow.md. `tree` ends each line with the element's frame in points from the window's
// top-left, the layout the accessibility tree carries and GPUI's own dump leaves out.
import AppKit
import ApplicationServices

func attribute(_ element: AXUIElement, _ name: String) -> AnyObject? {
	var value: AnyObject?
	return AXUIElementCopyAttributeValue(element, name as CFString, &value) == .success ? value : nil
}

func children(_ element: AXUIElement) -> [AXUIElement] {
	attribute(element, kAXChildrenAttribute) as? [AXUIElement] ?? []
}

func text(_ element: AXUIElement, _ name: String) -> String {
	(attribute(element, name) as? String) ?? ""
}

func frame(_ element: AXUIElement) -> CGRect? {
	guard let position = attribute(element, kAXPositionAttribute), let size = attribute(element, kAXSizeAttribute) else {
		return nil
	}
	var origin = CGPoint.zero
	var extent = CGSize.zero
	AXValueGetValue(position as! AXValue, .cgPoint, &origin)
	AXValueGetValue(size as! AXValue, .cgSize, &extent)
	return CGRect(origin: origin, size: extent)
}

func describe(_ element: AXUIElement, from window: CGPoint? = nil) -> String {
	let role = text(element, kAXRoleAttribute).replacingOccurrences(of: "AX", with: "")
	let label = [text(element, kAXTitleAttribute), text(element, kAXDescriptionAttribute)].first { !$0.isEmpty } ?? ""
	var line = label.isEmpty ? role : "\(role) \"\(label)\""
	if let value = attribute(element, kAXValueAttribute), !(value is [AnyObject]) {
		line += " = \(value)"
	}
	if let selected = attribute(element, kAXSelectedAttribute) as? Bool, selected {
		line += " (selected)"
	}
	if let window, let rect = frame(element) {
		line += "  @\(Int(rect.minX - window.x)),\(Int(rect.minY - window.y)) \(Int(rect.width))x\(Int(rect.height))"
	}
	return line
}

func dump(_ element: AXUIElement, _ depth: Int, _ window: CGPoint) {
	print(String(repeating: "  ", count: depth) + describe(element, from: window))
	for child in children(element) {
		dump(child, depth + 1, window)
	}
}

func find(_ element: AXUIElement, labelled label: String) -> AXUIElement? {
	for name in [kAXTitleAttribute, kAXDescriptionAttribute] where text(element, name) == label {
		return element
	}
	for child in children(element) {
		if let found = find(child, labelled: label) {
			return found
		}
	}
	return nil
}

let arguments = Array(CommandLine.arguments.dropFirst())
// Two builds are up more often than not -- `mise run dev` restarts leave the old one a moment,
// and a second checkout is a second window -- so RDM_PID picks one when the name is ambiguous.
let wantedPid = ProcessInfo.processInfo.environment["RDM_PID"].flatMap { Int32($0) }
guard let process = NSWorkspace.shared.runningApplications.first(where: {
	$0.localizedName == "Downloads" && (wantedPid == nil || $0.processIdentifier == wantedPid)
}) else {
	FileHandle.standardError.write("no Downloads process; `mise run dev` first\n".data(using: .utf8)!)
	exit(1)
}
let application = AXUIElementCreateApplication(process.processIdentifier)

func topLevelWindows() -> [AXUIElement] {
	children(application).filter { text($0, kAXRoleAttribute) == kAXWindowRole }
}

// AccessKit builds the tree lazily: the first query only switches it on, and the elements arrive
// with the next frame. So read once to wake it, and again if the first read came back bare.
// Every window is asked for its content on each pass -- a check that stopped at the first awake
// window left the ones after it asleep -- and a pass is repeated while any is still bare.
func bare(_ window: AXUIElement) -> Bool {
	children(window).allSatisfy { children($0).isEmpty }
}
var windows = topLevelWindows()
for _ in 0..<5 where windows.map(bare).contains(true) {
	usleep(300_000)
	windows = topLevelWindows()
}

switch arguments.first ?? "tree" {
case "windows":
	for window in windows {
		print(text(window, kAXTitleAttribute))
	}
case "tree":
	let wanted = arguments.dropFirst().first
	for window in windows where wanted.map({ text(window, kAXTitleAttribute).contains($0) }) ?? true {
		dump(window, 0, frame(window)?.origin ?? .zero)
	}
// A resize through the same attribute a user's drag on the window's edge ends at, which is how
// the system's own minimum size gets a say: ask for narrower than the window allows and what
// comes back is what it allowed. Nothing here moves the pointer. See spec/workflow.md.
case "size":
	guard let window = windows.first else {
		FileHandle.standardError.write("no window\n".data(using: .utf8)!)
		exit(1)
	}
	let numbers = arguments.dropFirst().compactMap { Double($0) }
	guard numbers.count == 2 else {
		FileHandle.standardError.write("usage: ax size <width> <height>\n".data(using: .utf8)!)
		exit(2)
	}
	var wanted = CGSize(width: numbers[0], height: numbers[1])
	if let value = AXValueCreate(.cgSize, &wanted) {
		AXUIElementSetAttributeValue(window, kAXSizeAttribute as CFString, value)
	}
	var got = CGSize.zero
	if let value = attribute(window, kAXSizeAttribute) {
		AXValueGetValue(value as! AXValue, .cgSize, &got)
	}
	print("asked \(Int(wanted.width))x\(Int(wanted.height)), got \(Int(got.width))x\(Int(got.height))")
case "press":
	let label = arguments.dropFirst().joined(separator: " ")
	// A window just woken has its frame buttons before GPUI's own elements, which arrive a frame
	// later, so the wait above can end with the label not there yet. Look again for a moment.
	var found = windows.lazy.compactMap({ find($0, labelled: label) }).first
	for _ in 0..<10 where found == nil {
		usleep(200_000)
		found = topLevelWindows().lazy.compactMap({ find($0, labelled: label) }).first
	}
	guard let target = found else {
		FileHandle.standardError.write("nothing labelled \"\(label)\"; `ax tree` lists what there is\n".data(using: .utf8)!)
		exit(1)
	}
	let result = AXUIElementPerformAction(target, kAXPressAction as CFString)
	if result != .success {
		FileHandle.standardError.write("press failed: \(result.rawValue)\n".data(using: .utf8)!)
		exit(1)
	}
	print("pressed \(describe(target))")
default:
	FileHandle.standardError.write("usage: ax tree [window] | ax press <label> | ax size <w> <h> | ax windows\n".data(using: .utf8)!)
	exit(2)
}

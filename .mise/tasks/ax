#!/usr/bin/env swift
//MISE description="The window through macOS accessibility: `ax tree [window] | ax press <label> | ax windows`"
// The accessibility tree is what a screen reader sees, and what an agent reads instead of a
// screenshot: every element GPUI gave a role and a label. `press` performs the element's own
// action through the same channel, so nothing moves the pointer or takes the keyboard. See
// spec/workflow.md.
import AppKit
import ApplicationServices

func attribute(_ element: AXUIElement, _ name: String) -> AnyObject? {
	var value: AnyObject?
	return AXUIElementCopyAttributeValue(element, name as CFString, &value) == .success ? value : nil
}

func children(_ element: AXUIElement) -> [AXUIElement] {
	attribute(element, kAXChildrenAttribute) as? [AXUIElement] ?? []
}

func text(_ element: AXUIElement, _ name: String) -> String {
	(attribute(element, name) as? String) ?? ""
}

func describe(_ element: AXUIElement) -> String {
	let role = text(element, kAXRoleAttribute).replacingOccurrences(of: "AX", with: "")
	let label = [text(element, kAXTitleAttribute), text(element, kAXDescriptionAttribute)].first { !$0.isEmpty } ?? ""
	var line = label.isEmpty ? role : "\(role) \"\(label)\""
	if let value = attribute(element, kAXValueAttribute), !(value is [AnyObject]) {
		line += " = \(value)"
	}
	if let selected = attribute(element, kAXSelectedAttribute) as? Bool, selected {
		line += " (selected)"
	}
	return line
}

func dump(_ element: AXUIElement, _ depth: Int) {
	print(String(repeating: "  ", count: depth) + describe(element))
	for child in children(element) {
		dump(child, depth + 1)
	}
}

func find(_ element: AXUIElement, labelled label: String) -> AXUIElement? {
	for name in [kAXTitleAttribute, kAXDescriptionAttribute] where text(element, name) == label {
		return element
	}
	for child in children(element) {
		if let found = find(child, labelled: label) {
			return found
		}
	}
	return nil
}

let arguments = Array(CommandLine.arguments.dropFirst())
guard let process = NSWorkspace.shared.runningApplications.first(where: { $0.localizedName == "Downloads" }) else {
	FileHandle.standardError.write("no Downloads process; `mise run dev` first\n".data(using: .utf8)!)
	exit(1)
}
let application = AXUIElementCreateApplication(process.processIdentifier)

func topLevelWindows() -> [AXUIElement] {
	children(application).filter { text($0, kAXRoleAttribute) == kAXWindowRole }
}

// AccessKit builds the tree lazily: the first query only switches it on, and the elements arrive
// with the next frame. So read once to wake it, and again if the first read came back bare.
var windows = topLevelWindows()
for _ in 0..<5 where windows.allSatisfy({ children($0).allSatisfy { children($0).isEmpty } }) {
	usleep(300_000)
	windows = topLevelWindows()
}

switch arguments.first ?? "tree" {
case "windows":
	for window in windows {
		print(text(window, kAXTitleAttribute))
	}
case "tree":
	let wanted = arguments.dropFirst().first
	for window in windows where wanted.map({ text(window, kAXTitleAttribute).contains($0) }) ?? true {
		dump(window, 0)
	}
case "press":
	let label = arguments.dropFirst().joined(separator: " ")
	guard let target = windows.lazy.compactMap({ find($0, labelled: label) }).first else {
		FileHandle.standardError.write("nothing labelled \"\(label)\"; `ax tree` lists what there is\n".data(using: .utf8)!)
		exit(1)
	}
	let result = AXUIElementPerformAction(target, kAXPressAction as CFString)
	if result != .success {
		FileHandle.standardError.write("press failed: \(result.rawValue)\n".data(using: .utf8)!)
		exit(1)
	}
	print("pressed \(describe(target))")
default:
	FileHandle.standardError.write("usage: ax tree [window] | ax press <label> | ax windows\n".data(using: .utf8)!)
	exit(2)
}

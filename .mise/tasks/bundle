#!/usr/bin/env python3
#MISE description="Build the release binary and wrap it as target/bundle/rdm.app"
"""The .app is a folder with a shape: the binary under Contents/MacOS, the icon under
Contents/Resources, and an Info.plist naming both. The plist is pkgs/macos/Info.plist with
its placeholders filled: the version out of Cargo.toml, the build number out of the CI run
that ordered the build (0 by hand), the bundle identifier out of src/identity.rs, so each has
one home. See spec/packaging.md.
"""

import os
import pathlib
import re
import shutil
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parents[2]
NAME = "rdm"


def read(pattern: str, path: pathlib.Path) -> str:
	match = re.search(pattern, path.read_text(), re.MULTILINE)
	if not match:
		raise SystemExit(f"error: {pattern!r} not found in {path.relative_to(ROOT)}")
	return match.group(1)


def main() -> int:
	version = read(r'^version = "([^"]+)"', ROOT / "Cargo.toml")
	bundle_id = read(r'^pub const BUNDLE_ID: &str = "([^"]+)";', ROOT / "src" / "identity.rs")
	icns = ROOT / "target" / "icon" / "rdm.icns"
	binary = ROOT / "target" / "release" / NAME
	if not icns.is_file():
		raise SystemExit("error: no icon; `mise run icon` first")
	if not binary.is_file():
		raise SystemExit("error: no release binary; `cargo build --release` first")
	app = ROOT / "target" / "bundle" / f"{NAME}.app"
	shutil.rmtree(app, ignore_errors=True)
	contents = app / "Contents"
	(contents / "MacOS").mkdir(parents=True)
	(contents / "Resources").mkdir()
	shutil.copy2(binary, contents / "MacOS" / NAME)
	shutil.copy2(icns, contents / "Resources" / f"{NAME}.icns")
	build = os.environ.get("GITHUB_RUN_NUMBER", "0")
	template = (ROOT / "pkgs" / "macos" / "Info.plist").read_text()
	filled = template.replace("{{VERSION}}", version).replace("{{BUILD}}", build).replace("{{BUNDLE_ID}}", bundle_id)
	if "{{" in filled:
		raise SystemExit("error: a placeholder in pkgs/macos/Info.plist was not filled")
	(contents / "Info.plist").write_text(filled)
	(contents / "PkgInfo").write_text("APPL????")
	# Ad hoc signature: unsigned binaries are refused by newer macOS even when run locally.
	subprocess.run(["codesign", "--force", "--sign", "-", str(app)], check=True, capture_output=True)
	size = sum(f.stat().st_size for f in app.rglob("*") if f.is_file())
	print(f"{app.relative_to(ROOT)}  {size / 1_000_000:.1f} MB  ({bundle_id} {version} build {build})")
	return 0


if __name__ == "__main__":
	raise SystemExit(main())

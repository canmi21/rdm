#!/usr/bin/env swift
//MISE description="Screenshot the running window to a file: `shot [path]`"
// Captures the rdm window alone; see spec/workflow.md. Swift because the window list is a
// CoreGraphics call and the system python has no bridge to it.
import CoreGraphics
import Foundation

let arguments = Array(CommandLine.arguments.dropFirst())
let output = arguments.first ?? "/tmp/rdm.png"
// A title picks one of the application's windows; without one the frontmost is taken.
let title = arguments.dropFirst().first
let windows = CGWindowListCopyWindowInfo([.optionOnScreenOnly, .excludeDesktopElements], kCGNullWindowID) as? [[String: Any]] ?? []
let found = windows.first { window in
	(window[kCGWindowOwnerName as String] as? String) == "rdm" && (window[kCGWindowLayer as String] as? Int) == 0
		&& title.map { (window[kCGWindowName as String] as? String)?.contains($0) ?? false } ?? true
}
guard let window = found, let id = window[kCGWindowNumber as String] as? Int else {
	FileHandle.standardError.write("no matching rdm window on screen; `mise run dev` first\n".data(using: .utf8)!)
	exit(1)
}
let capture = Process()
capture.executableURL = URL(fileURLWithPath: "/usr/sbin/screencapture")
capture.arguments = ["-x", "-o", "-l", String(id), output]
try capture.run()
capture.waitUntilExit()
if capture.terminationStatus != 0 { exit(capture.terminationStatus) }
print(output)

#!/usr/bin/env python3
#MISE description="Fetch the Lucide icons the source names into assets/lucide: `icons [--check]`"
"""The icons are not committed; the list of them is, in `src/ui/icon.rs`, and this fetches it.

Every `lucide/*.svg` path in `Icon::path` is one file to fetch from Lucide at the release pinned
below, plus the licence. The directory is named for the set because its files are the set's,
unchanged, under the set's licence: vendored content, named for the vendor. Files already on disk are skipped, so the build tasks depend on this
and pay nothing after the first run. The reasoning is in spec/icons.md.

`--check` reports what is missing without fetching, for a run with no network.
"""

from __future__ import annotations

import pathlib
import re
import sys
import urllib.error
import urllib.request

sys.dont_write_bytecode = True

# An exact release, raised on purpose; see spec/icons.md.
LUCIDE = "1.41.0"
RAW = f"https://raw.githubusercontent.com/lucide-icons/lucide/{LUCIDE}"

ROOT = pathlib.Path(__file__).resolve().parents[2]
SOURCE = ROOT / "src" / "ui" / "icon.rs"
ASSETS = ROOT / "assets"
PATH = re.compile(r'"(lucide/[a-z0-9-]+\.svg)"')


def declared() -> list[str]:
	found = sorted(set(PATH.findall(SOURCE.read_text())))
	if not found:
		raise SystemExit(f"error: no icon paths found in {SOURCE.relative_to(ROOT)}")
	return found


def fetch(url: str, target: pathlib.Path) -> None:
	try:
		with urllib.request.urlopen(url, timeout=20) as response:
			target.write_bytes(response.read())
	except urllib.error.HTTPError as error:
		raise SystemExit(f"error: {url} -> {error.code}; is the icon named as Lucide names it?") from error


def main(argv: list[str]) -> int:
	check = "--check" in argv
	# Upstream keeps them under icons/; here they sit under lucide/.
	wanted = [(f"{RAW}/icons/{path.split('/', 1)[1]}", ASSETS / path) for path in declared()]
	wanted.append((f"{RAW}/LICENSE", ASSETS / "lucide" / "LICENSE"))
	missing = [(url, target) for url, target in wanted if not target.is_file()]
	if check:
		for _, target in missing:
			print(f"missing {target.relative_to(ROOT)}")
		print(f"{len(wanted) - len(missing)} of {len(wanted)} present")
		return 1 if missing else 0
	for url, target in missing:
		target.parent.mkdir(parents=True, exist_ok=True)
		print(f"fetching {target.relative_to(ROOT)}")
		fetch(url, target)
	print(f"{len(missing)} fetched, {len(wanted)} present")
	return 0


if __name__ == "__main__":
	raise SystemExit(main(sys.argv[1:]))
